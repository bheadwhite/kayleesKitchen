rules_version = '2';

// Kitchen Help — Firestore security rules.
//
// This file is NOT deployed by `firebase deploy` (firebase.json has no
// `firestore` section). It is the reviewed copy of what should be pasted into
// Firebase console → Firestore → Rules. Keep the two in step by hand.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Mirrors ADMIN_EMAIL in src/admin.ts. Rules have no lower(), so this
    // compares the address in the token exactly as Firebase issued it.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'bheadwhite@gmail.com';
    }

    // The shared family recipe box: everyone signed in can read everything and
    // add their own. Deliberately not owner-scoped for writes — the app is a
    // household with a single shared collection, and existing recipes predate
    // any ownership field being reliably set.
    match /recipes/{docId} {
      allow read, write: if signedIn();

      // Copies of the recipe the chef made and someone kept — "feeds 8",
      // "dairy-free". Same shared-household stance as the recipe above them:
      // a doubled version is as useful to whoever cooks next as to the person
      // who asked for it, and the whole point of keeping one is that nobody
      // pays the model to work it out twice.
      //
      // **Rules do not cascade into subcollections**, so this block is what
      // grants access here — the `recipes/{docId}` rule above reaches the
      // recipe document and nothing beneath it.
      //
      // No update: a variant is a snapshot of what the chef handed back at a
      // moment, and an editable one is a recipe wearing the wrong label. Keep
      // another and forget this one.
      match /variants/{variantId} {
        allow read, create, delete: if signedIn();
        allow update: if false;
      }

      // What the chef worked out about the recipe — currently one document,
      // `yield`, holding how many it feeds and how that was read off it.
      //
      // **Written only by the `askChef` Cloud Function**, through the admin SDK,
      // which bypasses these rules entirely. So the client needs no write access
      // at all, and saying so outright is better than a rule nobody exercises —
      // same reasoning as `aiUsage`. It also means the figure on screen is one
      // the model produced and not one a client made up.
      match /chef/{docId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // How this recipe's ingredient lines respond to cooking for more people,
      // one document per version of those lines (the id is the ingredients
      // fingerprint). **Written only by the Cloud Function**, same as the
      // yield above it and for the same reason.
      //
      // This is the cache that matters most: one document answers *every*
      // serving count, so a session cooking for eleven costs nothing that a
      // session cooking for four has not already paid. Reading it needs no AI
      // entitlement — the chef's work becomes data the app uses on its own.
      match /scaling/{fingerprint} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Planning sessions — the first thing here scoped to a *group* rather than
    // to the household or to one person.
    //
    // Recipes are shared on the argument that a recipe is worth the same to
    // everyone. A week is not: it belongs to whoever is cooking it together,
    // which is neither "everybody signed in" nor "just me". `memberUids` is
    // both the access list and the query key.
    function sessionMembers(sid) {
      return get(/databases/$(database)/documents/sessions/$(sid)).data.memberUids;
    }

    function inSession(sid) {
      return signedIn() && request.auth.uid in sessionMembers(sid);
    }

    match /sessions/{sid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      // Starting one puts you in it and nobody else. Adding the others is the
      // invite flow below, which needs their consent.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      // A member may change the session — its name, how many it cooks for, or
      // the member list (asking someone in, or stepping out).
      //
      // The second clause is how somebody who is *not* yet a member joins one,
      // with no Cloud Function in the middle. It is deliberately narrow: the
      // only fields that may move are the two membership ones, the only uid
      // that may be added is your own, and an ask addressed to you has to
      // exist. That last check is only expressible because the invite id is
      // `{toUid}_{sessionId}` — derivable from what the rule already knows,
      // rather than something the client would otherwise have to be trusted to
      // name. (A caller who lies about the id simply fails `exists`.)
      allow update: if inSession(sid)
        || (
             signedIn()
             && !(request.auth.uid in resource.data.memberUids)
             && request.auth.uid in request.resource.data.memberUids
             && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
             && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['memberUids', 'members'])
             && exists(/databases/$(database)/documents/invites/$(request.auth.token.email + '_' + sid))
           );

      // **Only whoever started it may delete it.** Everybody else leaves,
      // which takes them out without taking the week away from the people
      // still cooking it. Someone who started a session by mistake — or three —
      // needs a way to be rid of them, and "leave" would strand them instead:
      // invisible to every query, and still there.
      //
      // The client sweeps `meals` and `shopping` first and deletes this
      // document last, because the rules below read *this* document to decide
      // who may touch them. Deleting the parent first would revoke the
      // permission needed to clear the children and orphan them permanently.
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // **Rules do not cascade**, so the two subcollections say it again for
      // themselves — and they cannot compare against the path the way
      // `plans/{uid}` once did, because membership lives in the parent
      // document. Each operation therefore costs one `get()` of the session.
      // That is a real read per tick in a shop, and it is the price of
      // membership meaning anything.
      match /meals/{mealId} {
        allow read, write: if inSession(sid);
      }

      match /shopping/{itemId} {
        allow read, write: if inSession(sid);
      }
    }

    // Asks to join a session, id `{toEmail}_{sessionId}`.
    //
    // Addressed by **email**, because a uid is not something the app can look
    // anybody up by — the `users` profiles hold names and addresses — and
    // because the address is in the token, so this costs no read. The id is
    // pinned to the document's own contents so a caller cannot file an ask at
    // one address and address it to another.
    //
    // Readable only by the person asked: an invite list is who wants whom in
    // what, and nobody else's business. Written by a member of the session
    // being offered; deleted by the person asked, which is both "yes" (once the
    // join has landed) and "no thanks".
    match /invites/{docId} {
      // Readable by the person asked, and by anyone already in the session it
      // is for — who can see the pending names in the session sheet anyway,
      // and who has to be able to sweep them when the session is deleted.
      //
      // That second clause is not a nicety. **Rules are not filters**: a query
      // is rejected outright if it *could* return a document the reader is not
      // allowed, so `where('sessionId', '==', x)` fails against a rule keyed
      // only on `toEmail`, however few documents actually match. Deleting a
      // session needs that query, so the rule has to make it provably safe.
      allow read: if signedIn()
        && (resource.data.toEmail == request.auth.token.email
            || inSession(resource.data.sessionId));
      allow create, update: if signedIn()
        && docId == request.resource.data.toEmail + '_' + request.resource.data.sessionId
        && request.resource.data.fromUid == request.auth.uid
        && inSession(request.resource.data.sessionId);
      // Deleted by the person asked — both "yes" (once the join has landed) and
      // "no thanks" — or by a member of the session, which is how an ask is
      // withdrawn and how a deleted session takes its unanswered asks with it.
      allow delete: if signedIn()
        && (resource.data.toEmail == request.auth.token.email
            || inSession(resource.data.sessionId));
    }

    // Which aisle an ingredient is found in. Written **only** by the Cloud
    // Function through the admin SDK, exactly like `aiUsage` and the yield —
    // this is what the chef worked out, and the callable is the only place that
    // knows it did not come from whoever typed it. Read by everyone, including
    // a household with no AI entitlement at all: that is the point of writing
    // it down.
    match /pantry/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // The tag registry — one document per tag, holding only the colour it is
    // drawn in. Same reasoning as recipes: a shared household vocabulary, so
    // anyone signed in can colour, rename, or retire a tag. Nothing private
    // lives here, and a tag nobody may edit is a tag nobody can fix a typo in.
    match /tags/{docId} {
      allow read, write: if signedIn();
    }

    // Profile documents, id = the person's **normalised email address**.
    //
    // Written at registration *after* the account is created, so the write is
    // authenticated (see `addUser` in services.ts).
    //
    // The id is pinned to the document's own `email` field, exactly as an
    // invite's is. That is what makes "one profile per person" an invariant
    // rather than a hope: the collection is readable and writable by anyone
    // signed in — it is a household roster, and the picker that asks people
    // into a session has to be able to list it — so nothing else here can stop
    // a second row for the same person from appearing.
    //
    // It bit exactly once and in the worst way. Registration is the only place
    // an address is stored *as typed* rather than read back from the auth
    // token, which Firebase has already lowercased; a capital letter there
    // filed a profile nothing could match, so the person appeared twice in the
    // picker and an ask sent to the unmatched spelling was invisible from both
    // ends — filtered out by their own `toEmail` query and denied by the
    // invite read rule.
    //
    // Lowercase cannot be checked here (rules have no `lower()`), so the pin is
    // to equality with the field; `profileRef` is what normalises, and it is
    // the only way this collection is addressed.
    // Create and update are spelled out separately from delete because
    // `request.resource` is null on a delete, so a single `write` clause
    // carrying this check would deny every deletion as a side effect rather
    // than as a decision. The decision is below, and it is the same one: a
    // profile is how a person appears in everyone else's picker, and nothing
    // in the app removes one.
    match /users/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && docId == request.resource.data.email;
      allow delete: if false;
    }

    // Ratings. One document per (recipe, rater), id `${recipeId}_${uid}`.
    //
    // **Read is limited to the author of the rating**, and that is the whole of
    // what makes ratings anonymous: nobody — not even the cook whose recipe it
    // is — can read who gave what. What everyone sees is `ratingSum` /
    // `ratingCount` on the recipe, which say nothing about who.
    //
    // You cannot rate your own recipe. Hiding the stars in the UI is a
    // decision about rendering; this is the part that enforces it. It costs one
    // document read per rating write, which is the price of the rule meaning
    // anything.
    //
    // No delete: an un-rating would have to move the totals back down, and
    // nothing here can check that it did.
    match /ratings/{docId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && get(/databases/$(database)/documents/recipes/$(request.resource.data.recipeId))
             .data.email != request.auth.token.email;
      allow delete: if false;
    }

    // AI usage — written by the Cloud Functions through the admin SDK, which
    // bypasses these rules entirely. The client therefore needs no write access
    // at all, and saying so outright is better than a rule nobody exercises.
    match /aiUsage/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The same calls, summed per day — one document per `YYYY-MM-DD`.
    //
    // The raw feed above is capped at 200 events and read newest-first, which
    // makes it the wrong instrument for "what did last month cost": a busy week
    // pushes the start of the month off the end of it. Raising the cap is not
    // the fix — an unbounded listener on a collection that grows with every AI
    // call is exactly what the cap exists to prevent. A rollup makes a month
    // thirty reads, the same way `ratingSum`/`ratingCount` make an average one.
    //
    // Written only by the Cloud Function through the admin SDK, like `aiUsage`
    // and `pantry`. Read by the admin alone: it is spend.
    match /aiUsageDaily/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Sign-in log. A user may record *their own* sign-in and nothing else:
    // without the uid check anyone could forge entries for anyone. No update or
    // delete — an audit log its subjects can edit is not an audit log.
    match /loginEvents/{docId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Anything not named above is denied by default. No catch-all rule is
    // needed — and a `match /{document=**} { allow read, write: if false; }`
    // would not add safety anyway, since rules are OR'd: a deny cannot override
    // an allow granted by a more specific match.
  }
}
