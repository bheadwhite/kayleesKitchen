// Rules for the admin console's two collections.
//
// ⚠️ THIS IS A SNIPPET TO MERGE, NOT A COMPLETE RULES FILE, AND IT IS NOT
// DEPLOYED. `firebase.json` has no `firestore` section on purpose: this project's
// rules live in the Firebase console, this repo has never held a copy of them,
// and publishing an invented rules file would overwrite whatever is protecting
// `recipes` and `users` today. Paste these two blocks into the existing ruleset
// in the console (Firestore → Rules), inside the same `match /databases/{db}/documents`.
//
// Until that happens, the admin console's `isAdmin()` check only hides the link.
// Any signed-in user can read `aiUsage` and `loginEvents` straight from the SDK.
//
//   Firestore → Rules → https://console.firebase.google.com/project/whatsfordinner-e69a4/firestore/rules

function isAdmin() {
  // Matches ADMIN_EMAIL in src/admin.ts. `lower()` is not available in rules,
  // so this compares the address Firebase issued in the token as-is.
  return request.auth != null && request.auth.token.email == 'bheadwhite@gmail.com';
}

// AI usage — written by the Cloud Functions with the admin SDK, which bypasses
// rules entirely. So the client needs no write access at all here, and `allow
// write: if false` is the honest expression of that.
match /aiUsage/{doc} {
  allow read: if isAdmin();
  allow write: if false;
}

// Sign-in events — written by the client at sign-in, read only by the admin.
//
// `create` is deliberately narrow: a user may record *their own* sign-in and
// nothing else. Without the uid check, any signed-in user could forge entries
// for anyone. There is no update or delete: an audit log that its subjects can
// edit is not an audit log.
match /loginEvents/{doc} {
  allow read: if isAdmin();
  allow create: if request.auth != null
                && request.resource.data.uid == request.auth.uid;
  allow update, delete: if false;
}
